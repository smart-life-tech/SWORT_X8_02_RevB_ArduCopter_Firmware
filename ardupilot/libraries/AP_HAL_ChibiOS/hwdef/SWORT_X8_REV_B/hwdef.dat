# SWORT X8 Rev-B hardware definition.
# Candidate target; validate against the approved schematic before release.

MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 25000000
STM32_ST_USE_TIMER 2
define STM32_LSECLK 32768U

# Board registration
APJ_BOARD_ID AP_HW_SWORT_X8_REV_B

# Internal flash configuration
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
FLASH_BOOTLOADER_LOAD_KB 128
INT_FLASH_PRIMARY 1

STORAGE_FLASH_PAGE 14
define HAL_STORAGE_SIZE 32768

# Required STM32H7 ADC DMA configuration.
# ADC1 is mapped to ADC12 by stm32h7_mcuconf.h.
define STM32_ADC_ADC1_DMA_STREAM STM32_DMA_STREAM_ID_ANY

# Crash dump configuration
define AP_CRASHDUMP_ENABLED 0

# External W25Q128JV firmware storage (16 MB).
# Not configured as a DataFlash logging backend.
EXT_FLASH_SIZE_MB 16
EXT_FLASH_RESERVE_START_KB 1024
EXT_FLASH_RESERVE_END_KB 448

# Serial port ordering
SERIAL_ORDER EMPTY UART7 USART1 USART3 UART4

define DEFAULT_SERIAL1_PROTOCOL SerialProtocol_MAVLink
define DEFAULT_SERIAL2_PROTOCOL SerialProtocol_GPS
define DEFAULT_SERIAL3_PROTOCOL SerialProtocol_MAVLink
define DEFAULT_SERIAL4_PROTOCOL SerialProtocol_RCIN

# SWD
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# UART7: CP2102N / USB-C bridge
PE7 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

# USART1: CN2, GPS
PA10 USART1_RX USART1
PA9 USART1_TX USART1

# USART3: CN4, companion / telemetry
PD9 USART3_RX USART3
PD8 USART3_TX USART3

# UART4: CN5, CRSF receiver
PD0 UART4_RX UART4
PD1 UART4_TX UART4

# IMU1: U2, ICM-42670-P on SPI1
PA4 IMU1_CS CS
PA5 SPI1_SCK SPI1
PA6 SPI1_MISO SPI1
PA7 SPI1_MOSI SPI1

PC12 IMU1_DRDY INPUT
PC11 IMU1_INT2 INPUT

SPIDEV icm42670 SPI1 DEVID1 IMU1_CS MODE3 2*MHZ 8*MHZ
IMU Invensensev3 SPI:icm42670 ROTATION_NONE

# IMU2: U3, ICM-42670-P on SPI2
PB12 IMU2_CS CS
PB13 SPI2_SCK SPI2
PB14 SPI2_MISO SPI2
PB15 SPI2_MOSI SPI2

PC10 IMU2_DRDY INPUT
PA15 IMU2_INT2 INPUT

SPIDEV icm42670_2 SPI2 DEVID1 IMU2_CS MODE3 2*MHZ 8*MHZ
IMU Invensensev3 SPI:icm42670_2 ROTATION_NONE

# I2C2: onboard MS5611 and RM3100
# Standard driver probing is used.
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2

I2C_ORDER I2C2
NODMA I2C*

define STM32_I2C_USE_DMA FALSE
define HAL_I2C_INTERNAL_MASK 1
define AP_COMPASS_PROBING_ENABLED 1

BARO MS5611 I2C:0:0x77

# QSPI1: W25Q128JV, 16 MB
PB2 QUADSPI_CLK QUADSPI1 SPEED_HIGH
PB6 QUADSPI_BK1_NCS QUADSPI1 SPEED_HIGH
PD11 QUADSPI_BK1_IO0 QUADSPI1 SPEED_HIGH
PD12 QUADSPI_BK1_IO1 QUADSPI1 SPEED_HIGH
PE2 QUADSPI_BK1_IO2 QUADSPI1 SPEED_HIGH
PD13 QUADSPI_BK1_IO3 QUADSPI1 SPEED_HIGH

# QSPI device declaration
QSPIDEV w25q QUADSPI1 MODE3 100*MHZ 24 1

# Conventional PWM outputs.
# DShot is intentionally not enabled.

PB1 TIM3_CH4 TIM3 PWM(1) GPIO(50) # ESC1
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51) # ESC2
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52) # ESC3
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53) # ESC4
PA8 TIM1_CH1 TIM1 PWM(5) GPIO(54) # ESC5
PB0 TIM3_CH3 TIM3 PWM(6) GPIO(55) # ESC6
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56) # ESC7
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(57) # ESC8

PC6 TIM8_CH1 TIM8 PWM(9) GPIO(58) # AUX1
PC7 TIM8_CH2 TIM8 PWM(10) GPIO(59) # AUX2
PC8 TIM8_CH3 TIM8 PWM(11) GPIO(60) # AUX3
PC9 TIM8_CH4 TIM8 PWM(12) GPIO(61) # AUX4